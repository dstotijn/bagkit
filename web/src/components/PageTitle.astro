---
// Like Mintlify: the sidebar group as an eyebrow, the title, and the page description as
// a subtitle.
const route = Astro.locals.starlightRoute;
const { title, description } = route.entry.data;

type Entry = (typeof route.sidebar)[number];
const groupOf = (entries: Entry[], group?: string): string | undefined => {
	for (const entry of entries) {
		if (entry.type === 'link' && entry.isCurrent) return group;
		if (entry.type === 'group') {
			const found = groupOf(entry.entries, entry.label);
			if (found) return found;
		}
	}
	return undefined;
};
const eyebrow = groupOf(route.sidebar);
---

<header class="page-title">
	{eyebrow && <p class="eyebrow">{eyebrow}</p>}
	<h1 id="_top">{title}</h1>
	{description && <p class="description">{description}</p>}
</header>

<style>
	.page-title {
		margin-top: 0.5rem;
	}
	.eyebrow {
		margin: 0 0 0.5rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-text-accent);
	}
	h1 {
		margin: 0;
		font-size: var(--sl-text-h1);
		line-height: 1.2;
		font-weight: 700;
		letter-spacing: -0.025em;
		color: var(--sl-color-white);
	}
	.description {
		margin: 0.75rem 0 0;
		font-size: var(--sl-text-lg);
		line-height: 1.6;
		color: var(--sl-color-gray-3);
	}
</style>
