{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"printWidth": 100,
	"ignorePatterns": ["dist", ".astro", "package-lock.json"],
	"overrides": [
		{
			"files": ["*.md", "*.mdx"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}
